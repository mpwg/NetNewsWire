          "stringUnit": {
            "state": "translated",
            "value": "Apple-Cloud ist für diese App noch nicht verfügbar. Bitte die lokale Zusammenfassung verwenden."
          }
        }
      }
    },
    "Apple cloud inference was disabled for this feed.": {
      "extractionState": "manual",
