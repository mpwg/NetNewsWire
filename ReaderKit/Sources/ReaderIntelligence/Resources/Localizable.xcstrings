  "strings": {
    "Apple Intelligence is not available on this device yet. Original articles remain accessible.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence is not available on this device yet. Original articles remain accessible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist auf diesem Gerät noch nicht verfügbar. Die Originale bleiben erreichbar."
          }
        }
      }
    },
    "Apple cloud inference is not configured for this app. Use on-device summaries.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple cloud inference is not configured for this app. Use on-device summaries."
          }
        },
